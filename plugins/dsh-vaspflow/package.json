{
  "name": "dsh-vaspflow",
  "version": "0.4.1",
  "description": "VASP 科研助手 for DeepSeek Harness 0.2: 右侧 VASP 任务面板（任务扫描、收敛曲线、3D 结构、文件浏览）+ 共享 Node 数据服务，vasp_* 工具仅在随附的 VASP Agent 预设中可用。",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-vaspflow": "scripts/install-dsh.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./preset-tools": {
      "default": "./preset/vasp/tools/vaspflow-tools.mjs"
    },
    "./preset-tool-only-output": {
      "default": "./preset/vasp/tools/tool-only-output.mjs"
    }
  },
  "files": [
    "INSTALL_FOR_AGENT.md",
    "README.md",
    "cordis.patch.yml",
    "lib",
    "preset",
    "preset/vasp.patch.yml",
    "scripts/install-dsh.mjs",
    "scripts/install-preset.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/vasp.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "antd": "^5.29.3",
    "recharts": "^2.15.4",
    "three": "^0.160.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "install-dsh": "node scripts/install-dsh.mjs",
    "install-preset": "node scripts/install-preset.mjs",
    "prepublishOnly": "npm run verify",
    "test": "node --test lib/host/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vasp",
    "dft",
    "first-principles",
    "science"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21271122/VASPFlow.git",
    "directory": "plugins/dsh-vaspflow"
  },
  "homepage": "https://github.com/21271122/VASPFlow#readme",
  "bugs": {
    "url": "https://github.com/21271122/VASPFlow/issues"
  }
}
